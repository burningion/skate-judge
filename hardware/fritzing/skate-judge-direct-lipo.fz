    <instance moduleIdRef="NoteModuleID" modelIndex="901" path="note.fzp">
      <title>ONE STEMMA QT CABLE</title>
      <text>&lt;html&gt;&lt;body style="font-family:Arial;font-size:9pt;"&gt;&lt;b&gt;ONE STEMMA QT CABLE&lt;/b&gt;&lt;br/&gt;Red: switched 3.3 V · black: GND · blue: SDA / GPIO3 · yellow: SCL / GPIO4. GPIO7 enables this rail; no extra wire.&lt;/body&gt;&lt;/html&gt;</text>
      <views>
        <breadboardView layer="breadboardNote">
          <geometry x="55" y="345" width="270" height="60" z="6" />
        </breadboardView>
