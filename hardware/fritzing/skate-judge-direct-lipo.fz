    <instance moduleIdRef="NoteModuleID" modelIndex="901" path="note.fzp">
      <title>ONE STEMMA QT CABLE</title>
      <text>&lt;html&gt;&lt;body style="font-family:Arial;font-size:9pt;"&gt;&lt;b&gt;ONE STEMMA QT CABLE&lt;/b&gt;&lt;br/&gt;Red: switched 3.3 V · black: GND · blue: SDA / GPIO3 · yellow: SCL / GPIO4. GPIO7 enables this rail; no extra wire.&lt;/body&gt;&lt;/html&gt;</text>
      <views>
        <breadboardView layer="breadboardNote">
          <geometry x="55" y="345" width="270" height="60" z="6" />
        </breadboardView>
      </views>
    </instance>
    <instance moduleIdRef="NoteModuleID" modelIndex="902" path="note.fzp">
      <title>LED STICK</title>
      <text>&lt;html&gt;&lt;body style="font-family:Arial;font-size:9pt;"&gt;&lt;b&gt;LED STICK&lt;/b&gt;&lt;br/&gt;GPIO5 (pad marked 5) is DATA, not 5 V. R1: recommended 330 Ω, near DIN. DOUT is unconnected. BAT supplies battery voltage, not regulated 5 V.&lt;/body&gt;&lt;/html&gt;</text>
      <views>
        <breadboardView layer="breadboardNote">
          <geometry x="550" y="205" width="195" height="115" z="6" />
        </breadboardView>
      </views>
    </instance>
    <instance moduleIdRef="NoteModuleID" modelIndex="903" path="note.fzp">
      <title>CHECK BEFORE SKATING</title>
      <text>&lt;html&gt;&lt;body style="font-family:Arial;font-size:9pt;"&gt;&lt;b&gt;CHECK BEFORE SKATING&lt;/b&gt;&lt;br/&gt;Direct LiPo is a bench-test option: this RGB stick is specified for 4–7 V, so operation below 4 V is not guaranteed. Test fully charged and partly discharged. Verify JST polarity. Insulate and protect the battery. Crossings without a junction are not connections.&lt;/body&gt;&lt;/html&gt;</text>
      <views>
        <breadboardView layer="breadboardNote">
          <geometry x="55" y="415" width="690" height="75" z="6" />
        </breadboardView>
      </views>
    </instance>
  </instances>
</module>