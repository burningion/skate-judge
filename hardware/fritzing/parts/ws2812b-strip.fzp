<?xml version="1.0" encoding="UTF-8"?>
<module fritzingVersion="1.0.5" moduleId="skate_judge_ws2812b_strip_3pixel_v1">
  <version>1</version>
  <author>skate-judge contributors</author>
  <title>WS2812B flexible RGB LED strip — 3 pixels</title>
  <label>LED</label>
  <date>2026-10-30</date>
  <description>Generic three-pixel flexible PCB strip with copper solder pads and cut marks. Match the actual strip's pad labels and data arrows; pad order, pitch and dimensions are illustrative. PCB view is not a production footprint.</description>
  <tags><tag>WS2812B</tag><tag>RGB</tag><tag>flexible strip</tag></tags>
  <properties>
    <property name="family">skate-judge flexible RGB strip</property>
    <property name="IC">WS2812B</property>
    <property name="pixels">3</property>
    <property name="variant">generic illustration</property>
  </properties>
  <views>
    <breadboardView><layers image="breadboard/skate-judge-ws2812b-strip.svg"><layer layerId="breadboard"/></layers></breadboardView>
    <iconView><layers image="breadboard/skate-judge-ws2812b-strip.svg"><layer layerId="breadboard"/></layers></iconView>
    <schematicView><layers image="schematic/skate-judge-ws2812b-strip.svg"><layer layerId="schematic"/></layers></schematicView>
    <pcbView><layers image="pcb/skate-judge-ws2812b-strip.svg"><layer layerId="copper1"/><layer layerId="copper0"/><layer layerId="silkscreen"/></layers></pcbView>
  </views>
  <connectors>
    <connector id="connector24" name="+5V input" type="pad">
      <description>Positive supply pad at the DIN end.</description>
      <views>
        <breadboardView><p layer="breadboard" svgId="connector24pin"/></breadboardView>
        <schematicView><p layer="schematic" svgId="connector24pin" terminalId="connector24terminal"/></schematicView>
        <pcbView><p layer="copper0" svgId="connector24pin"/><p layer="copper1" svgId="connector24pin"/></pcbView>
      </views>
    </connector>
    <connector id="connector25" name="DIN" type="pad">
      <description>Data input to the first pixel; GPIO5 through R1.</description>
      <views>
        <breadboardView><p layer="breadboard" svgId="connector25pin"/></breadboardView>
        <schematicView><p layer="schematic" svgId="connector25pin" terminalId="connector25terminal"/></schematicView>
        <pcbView><p layer="copper0" svgId="connector25pin"/><p layer="copper1" svgId="connector25pin"/></pcbView>
      </views>
    </connector>
    <connector id="connector26" name="GND input" type="pad">
      <description>Ground pad at the DIN end.</description>
      <views>
        <breadboardView><p layer="breadboard" svgId="connector26pin"/></breadboardView>
        <schematicView><p layer="schematic" svgId="connector26pin" terminalId="connector26terminal"/></schematicView>
        <pcbView><p layer="copper0" svgId="connector26pin"/><p layer="copper1" svgId="connector26pin"/></pcbView>
      </views>
    </connector>
    <connector id="connector21" name="+5V output" type="pad">
      <description>Positive supply continuation at the DOUT end.</description>
      <views>
        <breadboardView><p layer="breadboard" svgId="connector21pin"/></breadboardView>
        <schematicView><p layer="schematic" svgId="connector21pin" terminalId="connector21terminal"/></schematicView>
        <pcbView><p layer="copper0" svgId="connector21pin"/><p layer="copper1" svgId="connector21pin"/></pcbView>
      </views>
    </connector>
    <connector id="connector20" name="DOUT" type="pad">
      <description>Data output from the third pixel; leave unconnected.</description>
      <views>
        <breadboardView><p layer="breadboard" svgId="connector20pin"/></breadboardView>
        <schematicView><p layer="schematic" svgId="connector20pin" terminalId="connector20terminal"/></schematicView>
        <pcbView><p layer="copper0" svgId="connector20pin"/><p layer="copper1" svgId="connector20pin"/></pcbView>
      </views>
    </connector>
    <connector id="connector22" name="GND output" type="pad">
      <description>Ground continuation at the DOUT end.</description>
      <views>
        <breadboardView><p layer="breadboard" svgId="connector22pin"/></breadboardView>
        <schematicView><p layer="schematic" svgId="connector22pin" terminalId="connector22terminal"/></schematicView>
        <pcbView><p layer="copper0" svgId="connector22pin"/><p layer="copper1" svgId="connector22pin"/></pcbView>
      </views>
    </connector>
  </connectors>
  <buses>
    <bus id="positive"><nodeMember connectorId="connector24"/><nodeMember connectorId="connector21"/></bus>
    <bus id="ground"><nodeMember connectorId="connector26"/><nodeMember connectorId="connector22"/></bus>
  </buses>
</module>
