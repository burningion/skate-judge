<?xml version="1.0" encoding="UTF-8"?>
<module fritzingVersion="1.0.5" moduleId="skate_judge_lipo_500mah_v1">
  <version>1</version>
  <author>skate-judge contributors</author>
  <title>1S LiPo — 3.7 V 500 mAh</title>
  <label>BAT</label>
  <date>2026-09-07</date>
  <description>Generic single-cell LiPo illustration. Not a dimensional model or production PCB footprint. Verify the actual battery JST polarity.</description>
  <tags><tag>battery</tag><tag>LiPo</tag></tags>
  <properties>
    <property name="family">skate-judge LiPo</property>
    <property name="voltage">3.7 V nominal / 4.2 V full</property>
    <property name="capacity">500 mAh</property>
    <property name="variant">generic illustration</property>
  </properties>
  <views>
    <breadboardView><layers image="breadboard/skate-judge-lipo.svg"><layer layerId="breadboard"/></layers></breadboardView>
    <iconView><layers image="breadboard/skate-judge-lipo.svg"><layer layerId="breadboard"/></layers></iconView>
    <schematicView><layers image="schematic/skate-judge-lipo.svg"><layer layerId="schematic"/></layers></schematicView>
    <pcbView><layers image="pcb/skate-judge-lipo.svg"><layer layerId="copper1"/><layer layerId="copper0"/><layer layerId="silkscreen"/></layers></pcbView>
  </views>
  <connectors>
    <connector id="connector0" name="BAT+" type="male">
      <description>Battery positive: connect only to Feather battery JST positive.</description>
      <views>
        <breadboardView><p layer="breadboard" svgId="connector0pin"/></breadboardView>
        <schematicView><p layer="schematic" svgId="connector0pin" terminalId="connector0terminal"/></schematicView>
        <pcbView><p layer="copper0" svgId="connector0pin"/><p layer="copper1" svgId="connector0pin"/></pcbView>
      </views>
    </connector>
    <connector id="connector1" name="BAT−" type="male">
      <description>Battery negative: verify the actual JST polarity.</description>
      <views>
        <breadboardView><p layer="breadboard" svgId="connector1pin"/></breadboardView>
        <schematicView><p layer="schematic" svgId="connector1pin" terminalId="connector1terminal"/></schematicView>
        <pcbView><p layer="copper0" svgId="connector1pin"/><p layer="copper1" svgId="connector1pin"/></pcbView>
      </views>
    </connector>
  </connectors>
</module>
